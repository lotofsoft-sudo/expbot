# GEMINI_API_KEY: Required for Gemini AI natural language expense parser and smart assistant.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted (used for Telegram Webhook endpoints).
APP_URL=

# TELEGRAM_BOT_TOKEN: The Bot Token from @BotFather for Telegram Expense Bot integration.
TELEGRAM_BOT_TOKEN=

# GOOGLE_SHEETS_SPREADSHEET_ID: Target Google Spreadsheet ID from your spreadsheet URL.
GOOGLE_SHEETS_SPREADSHEET_ID=

# GOOGLE_SERVICE_ACCOUNT_EMAIL: Client email of your Google Cloud Service Account.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY: RSA Private Key from your Service Account JSON (with \n newlines).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# GOOGLE_SERVICE_ACCOUNT_JSON: Alternative single JSON string containing complete Service Account credentials.
GOOGLE_SERVICE_ACCOUNT_JSON=

# GOOGLE_CLOUD_PROJECT_ID: Google Cloud Project ID.
GOOGLE_CLOUD_PROJECT_ID=

# GOOGLE_SHEETS_SHEET_NAME: Target sheet/tab name in Google Spreadsheet (default: Expenses).
GOOGLE_SHEETS_SHEET_NAME=

# GOOGLE_SHEETS_RANGE: Target column range in Google Spreadsheet (default: A:O).
GOOGLE_SHEETS_RANGE=

# DEFAULT_CURRENCY: Standard corporate currency for all expense claims and vouchers (strictly SAR).
DEFAULT_CURRENCY=SAR

# EXPENSE_CURRENCY: Fixed currency identifier (SAR only for Saudi Riyal).
EXPENSE_CURRENCY=SAR
